# Copy this file to .env and fill in the two cookies. .env is gitignored.
# Chrome → fantasy.espn.com (signed in) → DevTools → Application → Cookies → https://fantasy.espn.com
ESPN_S2=
# Keep the curly braces, e.g. {ABCD1234-...}
SWID=

# League (from the league URL). Defaults below are Kevin's league.
ESPN_LEAGUE_ID=1851873571
ESPN_TEAM_ID=14
ESPN_SEASON=2027
